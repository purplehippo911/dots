{
    "layer": "top",
    "output": [
        "*"
    ],
    //"height": 10,
    "exclusive": true,
    "passthrough": false,
    "reload_style_on_change": true,
    "include": [
        "$XDG_CONFIG_HOME/waybar/modules/*json*", 
        "$XDG_CONFIG_HOME/waybar/includes/includes.json" 
    ],
    "modules-left": [
        "group/pill#left1"
    ],
    "group/pill#left1": {
        "orientation": "inherit",
        "modules": [
            "cpu",
            "memory",
	    "custom/updates",
	    "custom/vpn",
        ],
    },
    "modules-center": [
        "group/pill#center"
    ],
    "group/pill#center": {
        "modules": [
	    "idle_inhibitor",
            "clock",
	    "hyprland/workspaces",
	    "battery",
	    "tray"
        ],
        "orientation": "inherit"
    },
    "modules-right": [
        "group/pill#right3"
    ],
    "group/pill#right3": {
        "modules": [
           "custom/hyde-menu",
           "custom/power"
        ],
        "orientation": "inherit"
    }
}
