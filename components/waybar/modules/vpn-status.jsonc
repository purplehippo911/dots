{
	"custom/vpn": 
	{
    "return-type": "json",
		"format": "{text}",
		"tooltip": true,
		"tooltip-format": "vpn and killswitch",
 		"exec": "~/.config/waybar/scripts/vpn-status.sh",
		"interval": 5,
		"menu": "on-click",
		"menu-file": "~/.config/waybar/menus/vpn-menu.xml",
		"menu-actions": {
			"toggleVpn": "~/.config/waybar/scripts/vpn-check.sh",
			"toggleKs": "~/.config/waybar/scripts/killswitch-check.sh",
			"statusVpn": "~/.config/waybar/scripts/vpn-menu-status.sh",
			"statusKs": "~/.config/waybar/scripts/ks-menu-status.sh"
		}
	}
}
