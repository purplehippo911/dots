{
    "layer": "top",
    "output": [
        "*"
    ],
    //"height": 10,
    "exclusive": true,
    "passthrough": false,
    "reload_style_on_change": true,
    "include": [
        "~/.config/waybar/includes/includes.json" 
    ],
    "modules-left": [
        "group/pill#left1"
    ],
    "group/pill#left1": {
        "orientation": "inherit",
        "modules": [
	    "tray",
	    "custom/vpn",
	    "custom/updates"
        ]
    },
    "modules-center": [
        "group/pill#center"
    ],
    "group/pill#center": {
        "modules": [
            "clock",
	    "hyprland/workspaces",
	    "battery"
        ],
        "orientation": "inherit"
    },
    "modules-right": [
        "group/pill#right3"
    ],
    "group/pill#right3": {
        "modules": [
           "custom/power"
        ],
        "orientation": "inherit"
    }
}
