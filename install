#!/usr/bin/env fish

fish

if test $status -eq 1
  echo "download fish possiblese"
  exit error
end

echo "Downloading..."

sudo pacman -Syyu hyprland yay qbittorrent nwg-look gimp inkscape mission-center imv hyprlock cliphist proton-vpn-cli dunst hypridle hyprsunset wireplumber pipewire tmux openssh mosh git github-cli glab zsh blueman bash wine less ttf-jetbrains-mono-nerd unzip unrar tree-sitter-cli gcc make sudo rsync timeshift ollama fzf nodejs pnpm networkmanager waybar rofi fish sddm kitty gsettings-qt6 dolphin ark neovim steam vlc xfce4-terminal network-manager-applet wallbash flameshot shotcut audacity awww blender krita kdeconnect pipewire virtualbox

yay -S brave-bin caffeine-ng-git komiku batch-rename paru wlogout 

git clone https://github.com/ADIOR-enigma/hypr-sddm.git
cd hypr-sddm
sudo ./install.sh
cd ../

# Linux / MacOS (unix)
rm -rf ~/.config/nvim
rm -rf ~/.local/state/nvim
rm -rf ~/.local/share/nvim

git clone https://github.com/NvChad/starter ~/.config/nvim && nvim
