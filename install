#!/usr/bin/bash

set -e

echo "\nBefore running this app you need sudo downloaded or have root privileges"

sleep 3

sudo pacman -Syu
[ ! -d ~/.config/fish ] && mkdir -p ~/.config/fish
mv ./components/fish ~/.config/fish

echo "\nDone with fish\n"

# moving all files inside dots out into home directory?
echo "\nMoving files into home\n"
shopt -s dotglob; mv ./* ../

echo "\nDone moving files into home\n"

echo "\nDownloading through pacman...\n"

sudo pacman -S mesa lib32-mesa vulkan-intel lib32-vulkan-intel intel-media-driver libva-utils glow nvm noto-fonts-cjk usbutils zsh fish pacman-contrib expac breeze breeze-icons gdu qt6-virtualkeyboard brightnessctl yazi ex-vi-compat networkmanager hyprland nwg-look gimp inkscape imv cliphist proton-vpn-cli bat fd dunst wireplumber tmux openssh mosh vim lazygit github-cli glab blueman wine ttf-jetbrains-mono-nerd tree-sitter-cli gcc make rsync fzf waybar rofi fish sddm kitty gsettings-qt6 ark neovim vlc network-manager-applet kdenlive audacity awww blender krita kdeconnect pipewire man swaylock pamixer komikku ktimetracker hyprshot copyq qt6-declarative qt6-svg qt6-base qt5ct xdg-desktop-portal-gtk ttf-dejavu ttf-liberation noto-fonts adobe-source-code-pro-fonts adobe-source-sans-fonts adobe-source-serif-fonts htop bc

echo "\nDone with pacman\n"

echo "\nDownloading paru\n"
sudo pacman -S --needed base-devel
git clone https://aur.archlinux.org/paru.git
cd paru
makepkg -si
echo "\nDone downloading paru\n"

echo "\nDownlading through paru\n"
paru -S webcord-equicord-git brave-bin caffeine-ng-git wlogout hypremoji qt6ct-kde
echo "Done with paru\n"

echo "\nDownloading sddm theme\n"
git clone https://github.com/ADIOR-enigma/hypr-sddm.git
cd hypr-sddm
sudo ./install.sh
cd ../

echo "\nDone downloading sddm theme\n"

echo "Downloading nvchad nvim plugin"
# Linux / MacOS (unix)
rm -rf ~/.config/nvim
rm -rf ~/.local/state/nvim
rm -rf ~/.local/share/nvim

git clone https://github.com/NvChad/starter ~/.config/nvim && nvim
echo "Done downloading nvim plugin"

echo "moving custom scripts to /usr/local/bin"
sudo mv components/bin /usr/local/bin

echo "done moving custom scripts to /usr/local/bin"

# use own config hyrp
[ ! -d ~/.config/hypr ] && mkdir -p ~/.config/hypr
cp -r ~/components/hypr/{hyprland.conf,scripts} ~/.config/hypr

# waybar component
[ ! -d ~/.config/waybar] && mkdir -p ~/.config/waybar

cp -r ~/components/waybar ~/.config/waybar

echo "installed waybar"

# font
sudo fc-cache -fv

# Global GTK3/4 font
echo "setting up font for GTK3/4 apps"
gsettings set org.gnome.desktop.interface font-name 'Noto Sans CJK HK Regular 12'

# GTK2 (older apps)
echo "setting up font for GTK2 apps"
echo "gtk-font-name=Noto Sans CJK HK Regular 12" >> ~/.gtkrc-2.0

# Permanent (Fish config.fish)
echo 'set -gx QT_FONT_NAME "Noto Sans CJK HK Regular 12"' >> ~/.config/fish/config.fish

# Edit config
echo "setting up font for kitty"
[ ! -f ~/.config/kitty ] && mkdir -p ~/.config/kitty
echo 'font_family JetBrainsMono Nerd Font Mono' >> ~/.config/kitty/kitty.conf
echo 'font_size 12' >> ~/.config/kitty/kitty.conf

# enabling sddm
echo "\n enabling sddm\n"
sudo systemctl enable sddm
echo "done with downloading and setting up fonts"

# enabling audio
echo "enabling audio"
systemctl --user enable --now pipewire pipewire-pulse wireplumber
systemctl --user status pipewire pipewire-pulse wireplumber

echo "done with audio"

echo "sending gdu.desktop to /usr/local/bin so rofi can see it"
[ ! -d /usr/share/applications ] && sudo mkdir -p /usr/share/applications
mv ~/components/gdu.desktop /usr/share/applications
echo "done with gdu setup"

echo "setting up virtual-manager"
sudo pacman -S virt-manager qemu-full libvirt dnsmasq ebtables bridge-utils openbsd-netcat libguestfs

sudo systemctl enable --now libvirtd.service
sudo systemctl enable --now libvirtd.socket  # For QEMU connections

sudo usermod -aG libvirt $USER
newgrp libvirt  # Or log out/in
sudo virsh net-autostart default
sudo systemctl restart libvirtd

echo "done with virtual-machine download"

echo "I highly recommend you to setup timeshift yourself"

echo "\n now you can bring bck your stuff youve backed uplike notes from elsewhere"

echo "also remember to reboot system and restart kitty"
